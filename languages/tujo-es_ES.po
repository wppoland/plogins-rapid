#. Plugin Name of the plugin
#: tujo.php
msgid "Tujo - Quick Order for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: tujo.php
msgid "https://plogins.com/plogins-rapid/"
msgstr ""

#. Description of the plugin
#: tujo.php
msgid ""
"A fast bulk order form so B2B and wholesale buyers can add many products at "
"once."
msgstr ""
"Un formulario de pedido al por mayor rápido para que los compradores B2B y "
"mayoristas puedan añadir muchos productos a la vez."

#. Author of the plugin
#: tujo.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
#: tujo.php
msgid "https://wppoland.com"
msgstr ""

#: tujo.php:48
msgid "Tujo requires WooCommerce to be active."
msgstr ""
"Rápido: el formulario de pedido rápido para WooCommerce requiere que "
"WooCommerce esté activo."

